            {"color": "yellow", "value": 1},
            {"color": "red", "value": 10}
          ]},
          "mappings": [{"options": {"0": {"text": "Clear"}}, "type": "value"}]
        }
      },
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Revenue Cycle Backlog (Claims)",
      "description": "Queued 837/835/270/271 = revenue at risk. Every hour of delay compounds DSO and payer-deadline risk.",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 3},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
