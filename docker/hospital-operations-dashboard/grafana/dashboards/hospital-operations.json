    {
      "type": "text",
      "id": 100,
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "options": {
        "mode": "markdown",
        "content": "## Hospital Integration Operations — Mirth Connect\nThis view shows clinical impact, not channel mechanics. Each panel answers: *what does this mean for patients, clinicians, and revenue?* Drill in by interface (ADT, Orders, Results, Pharmacy, Claims) — not by channel name."
      }
    },

    {
      "type": "stat",
      "id": 1,
      "title": "Patient-Impact Backlog (ADT)",
      "description": "Queued ADT messages = bed management & registration operating blind. Every queued message can be a delayed admission, bed assignment, or census update.",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 3},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "sum(mirth_interface_queue_depth{interface_type=\"ADT\"})", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 5},
            {"color": "red", "value": 25}
          ]},
          "mappings": [{"options": {"0": {"text": "Clear"}}, "type": "value"}]
        }
      },
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Lab/Rad Results Backlog",
      "description": "Queued results = clinicians waiting. STAT/critical results blocked here are a patient-safety issue. Target: 0 during clinical hours.",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 3},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [{"expr": "sum(mirth_interface_queue_depth{interface_type=\"Results\"})", "refId": "A"}],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "red", "value": 10}
          ]},
          "mappings": [{"options": {"0": {"text": "Clear"}}, "type": "value"}]
        }
      },
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "center", "textMode": "value_and_name", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Order Routing Backlog",
      "description": "Queued ORM = lab/rad/pharmacy orders not delivered. Delays diagnostic workups and medication starts.",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 3},
