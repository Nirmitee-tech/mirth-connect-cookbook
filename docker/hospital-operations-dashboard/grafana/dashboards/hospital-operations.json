    {
      "type": "table",
      "id": 5,
      "title": "Critical Interface Status",
      "description": "Each row is a clinical workflow. State + last activity + queue depth tell you whether the workflow is healthy.",
      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "mirth_channel_state{state=\"STARTED\"} == 1", "format": "table", "instant": true, "refId": "A"},
        {"expr": "mirth_channel_queued", "format": "table", "instant": true, "refId": "B"},
        {"expr": "mirth_channel_errored_total", "format": "table", "instant": true, "refId": "C"},
        {"expr": "mirth_channel_received_total", "format": "table", "instant": true, "refId": "D"},
        {"expr": "mirth_channel_seconds_since_last_message", "format": "table", "instant": true, "refId": "E"}
      ],
      "transformations": [
        {"id": "merge"},
        {"id": "organize", "options": {
          "excludeByName": {"Time": true, "__name__": true, "channel_id": true, "env": true, "instance": true, "job": true, "state": true},
          "indexByName": {
            "interface_type": 0,
            "channel": 1,
            "clinical_impact": 2,
            "Value #A": 3,
            "Value #D": 4,
            "Value #B": 5,
            "Value #C": 6,
            "Value #E": 7
          },
          "renameByName": {
            "interface_type": "Interface",
            "channel": "Channel",
            "clinical_impact": "Clinical Impact",
            "Value #A": "Up",
            "Value #D": "Processed",
            "Value #B": "Queued",
            "Value #C": "Errors",
            "Value #E": "Last Msg (s ago)"
          }
        }}
      ],
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}, "custom": {"align": "left", "cellOptions": {"type": "auto"}}},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Up"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "mappings", "value": [
                {"options": {"1": {"color": "green", "text": "STARTED"}}, "type": "value"}
              ]},
              {"id": "custom.width", "value": 90}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Queued"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 1},
                {"color": "red", "value": 10}
              ]}},
              {"id": "custom.width", "value": 90}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Errors"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [
                {"color": "green", "value": null},
                {"color": "red", "value": 1}
              ]}},
              {"id": "custom.width", "value": 90}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Last Msg (s ago)"},
            "properties": [
              {"id": "custom.cellOptions", "value": {"type": "color-background"}},
              {"id": "thresholds", "value": {"mode": "absolute", "steps": [
                {"color": "green", "value": null},
                {"color": "yellow", "value": 300},
                {"color": "red", "value": 900}
              ]}},
              {"id": "unit", "value": "s"},
              {"id": "custom.width", "value": 140}
            ]
          },
          {
            "matcher": {"id": "byName", "options": "Interface"},
            "properties": [{"id": "custom.width", "value": 130}]
          },
          {
            "matcher": {"id": "byName", "options": "Clinical Impact"},
            "properties": [{"id": "custom.width", "value": 260}]
          }
        ]
      },
      "options": {"cellHeight": "md", "footer": {"show": false}, "showHeader": true, "sortBy": [{"desc": true, "displayName": "Queued"}]}
    },

    {
      "type": "timeseries",
      "id": 6,
      "title": "Clinical Message Throughput (msg/sec) by interface type",
      "description": "Sustained throughput drop on ADT or Results = upstream system trouble (EHR, lab, RIS). Spike on Claims = end-of-day batch arrived.",
      "gridPos": {"h": 9, "w": 16, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum by (interface_type) (rate(mirth_interface_messages_received_total[1m]))", "legendFormat": "{{interface_type}}", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2,
            "fillOpacity": 25, "gradientMode": "opacity", "showPoints": "never",
            "stacking": {"group": "A", "mode": "none"}
          },
          "unit": "ops"
        }
      },
      "options": {"legend": {"calcs": ["mean", "max"], "displayMode": "table", "placement": "right"}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },

