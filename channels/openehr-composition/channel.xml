          <script>// =====================================================
// HL7v2 ADT → openEHR FLAT Composition
// Target: Patient admission template for EHRbase CDR
// NOTE: Mirth has ZERO native openEHR support —
//       everything here is custom-built
// =====================================================

// --- Extract HL7v2 fields ---
var mrn = msg[&apos;PID&apos;][&apos;PID.3&apos;][&apos;PID.3.1&apos;].toString();
var lastName = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.1&apos;].toString();
var firstName = msg[&apos;PID&apos;][&apos;PID.5&apos;][&apos;PID.5.2&apos;].toString();
var dob = msg[&apos;PID&apos;][&apos;PID.7&apos;][&apos;PID.7.1&apos;].toString();
var gender = msg[&apos;PID&apos;][&apos;PID.8&apos;][&apos;PID.8.1&apos;].toString();
var street = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.1&apos;].toString();
var city = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.3&apos;].toString();
var state = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.4&apos;].toString();
var zip = msg[&apos;PID&apos;][&apos;PID.11&apos;][&apos;PID.11.5&apos;].toString();
var phone = msg[&apos;PID&apos;][&apos;PID.13&apos;][&apos;PID.13.1&apos;].toString();

var patientClass = msg[&apos;PV1&apos;][&apos;PV1.2&apos;][&apos;PV1.2.1&apos;].toString();
var ward = msg[&apos;PV1&apos;][&apos;PV1.3&apos;][&apos;PV1.3.1&apos;].toString();
var room = msg[&apos;PV1&apos;][&apos;PV1.3&apos;][&apos;PV1.3.2&apos;].toString();
var bed = msg[&apos;PV1&apos;][&apos;PV1.3&apos;][&apos;PV1.3.3&apos;].toString();
var attendingId = msg[&apos;PV1&apos;][&apos;PV1.7&apos;][&apos;PV1.7.1&apos;].toString();
var attendingLastName = msg[&apos;PV1&apos;][&apos;PV1.7&apos;][&apos;PV1.7.2&apos;].toString();
var attendingFirstName = msg[&apos;PV1&apos;][&apos;PV1.7&apos;][&apos;PV1.7.3&apos;].toString();

var diagCode = &apos;&apos;;
var diagDesc = &apos;&apos;;
try {
    diagCode = msg[&apos;DG1&apos;][&apos;DG1.3&apos;][&apos;DG1.3.1&apos;].toString();
    diagDesc = msg[&apos;DG1&apos;][&apos;DG1.3&apos;][&apos;DG1.3.2&apos;].toString();
} catch(e) {}

// =====================================================
// CODE MAPPING: HL7v2 → openEHR coded values
// =====================================================

// Gender: HL7v2 → openEHR DV_CODED_TEXT (local codes)
var genderMap = {
    &apos;M&apos;: {code: &apos;at0003&apos;, value: &apos;Male&apos;, terminology: &apos;local&apos;},
    &apos;F&apos;: {code: &apos;at0004&apos;, value: &apos;Female&apos;, terminology: &apos;local&apos;},
    &apos;O&apos;: {code: &apos;at0005&apos;, value: &apos;Other&apos;, terminology: &apos;local&apos;},
    &apos;U&apos;: {code: &apos;at0006&apos;, value: &apos;Unknown&apos;, terminology: &apos;local&apos;}
};
var ehrGender = genderMap[gender] || genderMap[&apos;U&apos;];

// Patient Class: HL7v2 → openEHR local codes
var classMap = {
    &apos;I&apos;: {code: &apos;at0010&apos;, value: &apos;Inpatient&apos;},
    &apos;O&apos;: {code: &apos;at0011&apos;, value: &apos;Outpatient&apos;},
    &apos;E&apos;: {code: &apos;at0012&apos;, value: &apos;Emergency&apos;}
};
var ehrClass = classMap[patientClass] || {code: &apos;at0011&apos;, value: &apos;Outpatient&apos;};

// Format dates for openEHR (ISO 8601)
var fhirDob = &apos;&apos;;
if (dob.length &gt;= 8) {
    fhirDob = dob.substring(0, 4) + &apos;-&apos; + dob.substring(4, 6) + &apos;-&apos; + dob.substring(6, 8);
}
var nowISO = new Date().toISOString();

// =====================================================
// BUILD openEHR FLAT Composition
// Template: patient_admission.v1
// =====================================================
// NOTE: This is the FLAT format used by EHRbase REST API
// Path notation: template_id/path|suffix

var templateId = &apos;patient_admission.v1&apos;;

var flatComposition = {};

// Composition metadata
flatComposition[&apos;ctx/language&apos;] = &apos;en&apos;;
flatComposition[&apos;ctx/territory&apos;] = &apos;US&apos;;
flatComposition[&apos;ctx/composer_name&apos;] = attendingFirstName + &apos; &apos; + attendingLastName;
flatComposition[&apos;ctx/composer_id&apos;] = attendingId;
flatComposition[&apos;ctx/id_namespace&apos;] = &apos;HOSPITAL&apos;;
flatComposition[&apos;ctx/id_scheme&apos;] = &apos;HOSPITAL&apos;;
flatComposition[&apos;ctx/time&apos;] = nowISO;
flatComposition[&apos;ctx/health_care_facility|name&apos;] = ward + &apos; Room &apos; + room;
flatComposition[&apos;ctx/health_care_facility|id&apos;] = ward + &apos;-&apos; + room + &apos;-&apos; + bed;

// Patient demographics (ADMIN_ENTRY)
var demoPath = templateId + &apos;/patient_demographics:0&apos;;
flatComposition[demoPath + &apos;/patient_name/family_name&apos;] = lastName;
flatComposition[demoPath + &apos;/patient_name/given_name&apos;] = firstName;
flatComposition[demoPath + &apos;/date_of_birth&apos;] = fhirDob;
flatComposition[demoPath + &apos;/gender|code&apos;] = ehrGender.code;
flatComposition[demoPath + &apos;/gender|value&apos;] = ehrGender.value;
flatComposition[demoPath + &apos;/gender|terminology&apos;] = ehrGender.terminology;
flatComposition[demoPath + &apos;/patient_identifier/mrn&apos;] = mrn;
flatComposition[demoPath + &apos;/patient_identifier/issuer&apos;] = &apos;HOSPITAL&apos;;

// Address
flatComposition[demoPath + &apos;/address/street&apos;] = street;
flatComposition[demoPath + &apos;/address/city&apos;] = city;
flatComposition[demoPath + &apos;/address/state&apos;] = state;
flatComposition[demoPath + &apos;/address/postal_code&apos;] = zip;
flatComposition[demoPath + &apos;/address/country&apos;] = &apos;US&apos;;

// Phone
flatComposition[demoPath + &apos;/telecom:0/contact_value&apos;] = phone;
flatComposition[demoPath + &apos;/telecom:0/contact_type|code&apos;] = &apos;at0020&apos;;
flatComposition[demoPath + &apos;/telecom:0/contact_type|value&apos;] = &apos;Phone&apos;;

// Admission details (ADMIN_ENTRY)
var admitPath = templateId + &apos;/admission_details:0&apos;;
flatComposition[admitPath + &apos;/admission_date_time&apos;] = nowISO;
flatComposition[admitPath + &apos;/patient_class|code&apos;] = ehrClass.code;
flatComposition[admitPath + &apos;/patient_class|value&apos;] = ehrClass.value;
flatComposition[admitPath + &apos;/patient_class|terminology&apos;] = &apos;local&apos;;
flatComposition[admitPath + &apos;/assigned_location/ward&apos;] = ward;
flatComposition[admitPath + &apos;/assigned_location/room&apos;] = room;
flatComposition[admitPath + &apos;/assigned_location/bed&apos;] = bed;
flatComposition[admitPath + &apos;/attending_physician/name&apos;] = attendingFirstName + &apos; &apos; + attendingLastName;
flatComposition[admitPath + &apos;/attending_physician/identifier&apos;] = attendingId;

// Diagnosis (EVALUATION)
if (diagCode) {
    var diagPath = templateId + &apos;/problem_diagnosis:0&apos;;
    flatComposition[diagPath + &apos;/problem_diagnosis_name|code&apos;] = diagCode;
    flatComposition[diagPath + &apos;/problem_diagnosis_name|value&apos;] = diagDesc;
    flatComposition[diagPath + &apos;/problem_diagnosis_name|terminology&apos;] = &apos;ICD10&apos;;
    flatComposition[diagPath + &apos;/date_time_of_onset&apos;] = nowISO;
    flatComposition[diagPath + &apos;/diagnostic_certainty|code&apos;] = &apos;at0074&apos;;
    flatComposition[diagPath + &apos;/diagnostic_certainty|value&apos;] = &apos;Confirmed&apos;;
    flatComposition[diagPath + &apos;/active_inactive|code&apos;] = &apos;at0035&apos;;
    flatComposition[diagPath + &apos;/active_inactive|value&apos;] = &apos;Active&apos;;
}

// =====================================================
// BUILD EHRbase REST API request
// =====================================================
var ehrbaseRequest = {
    method: &apos;POST&apos;,
    url: &apos;/ehr/{ehr_id}/composition&apos;,
    headers: {
        &apos;Content-Type&apos;: &apos;application/json&apos;,
        &apos;Accept&apos;: &apos;application/json&apos;,
        &apos;Prefer&apos;: &apos;return=representation&apos;
    },
    queryParams: {
        &apos;templateId&apos;: templateId,
        &apos;format&apos;: &apos;FLAT&apos;
    },
    body: flatComposition
};

// Store outputs
channelMap.put(&apos;openehrComposition&apos;, JSON.stringify(flatComposition, null, 2));
channelMap.put(&apos;ehrbaseRequest&apos;, JSON.stringify(ehrbaseRequest, null, 2));
channelMap.put(&apos;templateId&apos;, templateId);
channelMap.put(&apos;patientId&apos;, mrn);
channelMap.put(&apos;fieldCount&apos;, Object.keys(flatComposition).length.toString());

logger.info(&apos;HL7v2 ADT -&gt; openEHR FLAT: &apos; + Object.keys(flatComposition).length + &apos; fields | Template: &apos; + templateId + &apos; | Patient: &apos; + firstName + &apos; &apos; + lastName);</script>
